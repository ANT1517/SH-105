    "status": "success",
    "message": "Business ledger entry recorded successfully",
    "ledger_entry": {
      "id": 2,
      "user_id": "meera_001",
      "activity": "pickle sales",
      "revenue": 1000,
      "cost": 600,
      "profit": 400,
      "notes": "Sold 10 pickle bottles",
      "created_at": "2026-09-18T14:36:00.000Z"
