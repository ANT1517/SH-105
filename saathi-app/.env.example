# Backend services the app talks to: one variable per service (read in src/services/apiConfig.js).
# Expo inlines EXPO_PUBLIC_* at build time; they are visible in the app bundle, so never put secrets here.
#
# On a phone or emulator "localhost" is the device itself: use your computer's LAN address
# (Android emulator: http://10.0.2.2:<port>).

# Person B: financial memory (pots, ledger, goals, transactions, audit log)
EXPO_PUBLIC_PERSON_B_API_URL=http://localhost:5000

# Person C: guidance + safety checks (the only service allowed to generate financial content)
EXPO_PUBLIC_PERSON_C_API_URL=http://localhost:8000

# saathi-nlp: language understanding only (intent + entities), no advice
EXPO_PUBLIC_NLP_API_URL=http://localhost:8002

# Dev-A: speech-to-text for the mic button (the same Whisper model the WhatsApp bot uses)
EXPO_PUBLIC_VOICE_API_URL=http://localhost:8001

# Which user this device acts as. Must exist in Person B (or be a phone number mapped in its PHONE_USER_MAP).
EXPO_PUBLIC_USER_ID=meera_001
