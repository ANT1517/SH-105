PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saathi_db
NODE_ENV=development

# Maps Twilio WhatsApp senders ("whatsapp:+91...") to existing user_ids such as meera_001.
# REQUIRED for the demo to resolve to the right user; unmapped phone numbers are rejected (422).
# The number below is a PLACEHOLDER -- replace with the real demo phone number.
PHONE_USER_MAP={"+919876543210":"meera_001"}
